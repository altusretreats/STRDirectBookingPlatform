{
  "name": "altus-retreats-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "jest": "^29.0.0",
    "stripe": "^14.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "moduleNameMapper": {
      "^/opt/nodejs/lib/(.*)$": "<rootDir>/layers/shared/nodejs/lib/$1"
    },
    "collectCoverageFrom": ["functions/**/index.js", "layers/**/*.js"]
  }
}
